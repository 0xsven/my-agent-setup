{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:PORT/mcp",
      "enabled": false
    },
    "pencil": {
      "type": "local",
      "command": ["/absolute/path/to/pencil-mcp-server", "--app", "desktop", "--agent", "openCodeCLI"],
      "enabled": false
    }
  }
}
