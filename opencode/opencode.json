{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "plan",
  "compaction": {
    "auto": true,
    "buffer": 32000,
    "keep": { "tokens": 15000 }
  },
  "agent": {
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "visual": "allow"
        }
      }
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "task": "deny"
      }
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "options": {
        "reasoningEffort": "medium"
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated=true",
        "--no-usage-statistics"
      ]
    },
    "figma-mcp-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    }
  },
  "plugins": [
    "./plugins/compaction-reasoning.ts",
    "./plugins/rtk.ts"
  ],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "low",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.6": {
          "name": "GPT 5.6 (OAuth)",
          "limit": {
            "context": 272000,
            "input": 272000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": { "none": { "reasoningEffort": "none" }, "low": { "reasoningEffort": "low" }, "medium": { "reasoningEffort": "medium" }, "high": { "reasoningEffort": "high" }, "xhigh": { "reasoningEffort": "xhigh" } }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol (OAuth)",
