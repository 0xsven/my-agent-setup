{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "plan",
  "compaction": {
    "auto": true,
    "reserved": 32000,
    "preserve_recent_tokens": 15000
  },
  "agent": {
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "visual": "allow"
        }
      }
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "permission": {
        "task": "deny"
      }
    },
    "compaction": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "options": { "reasoningEffort": "medium" }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated=true",
        "--no-usage-statistics"
      ]
    },
    "figma-mcp-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    }
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "low",
        "include": ["reasoning.encrypted_content"],
        "store": false
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol (OAuth)",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna (OAuth)",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "gpt-6-astra": {
          "name": "GPT 6 Astra (OAuth)",
          "limit": { "context": 272000, "input": 272000, "output": 128000 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    }
  }
}
